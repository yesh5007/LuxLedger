# Copy this file to .env.local and fill in your own values.

# Google Gemini API key used for OCR and forgery-detection analysis
# (see lib/services/ai-forgery.ts and lib/services/metadata-extraction.ts)
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# WalletConnect/Web3Modal project ID
NEXT_PUBLIC_PROJECT_ID=your_walletconnect_project_id

# Private key used to deploy LuxLedgerRegistry.sol to Polygon Amoy via Hardhat
# (see hardhat.config.ts) - only needed for contract deployment, not for running the app
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here
